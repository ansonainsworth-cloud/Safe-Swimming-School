---
import { googleReviews, googleReviewsReady } from '../data/google-reviews';
const show = googleReviewsReady();
---
{show && (
  <p class="sss-google-rating">Google rating {googleReviews.rating} from {googleReviews.count} reviews. <a href={googleReviews.url!}>Read the reviews</a></p>
)}
<style>
.sss-google-rating{margin:0;padding:8px 16px;text-align:center;background:#f4f7fb;color:var(--sss-ink);font-size:15px}
.sss-google-rating a{font-weight:700}
</style>
