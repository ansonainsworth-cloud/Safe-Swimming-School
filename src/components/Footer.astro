---
import { FOOTER_LINKS } from '../data/site.js';
---
<footer id="footer-builder" class="footer-builder clr" itemscope="itemscope" itemtype="http://schema.org/WPFooter">
  <div class="footer-builder-content clr container entry">
    <div class="vc_row wpb_row vc_row-fluid vc_custom_1591354460539"><div class="wpb_column vc_column_container vc_col-sm-6"><div class="vc_column-inner"><div class="wpb_wrapper"><h2 style="text-align: left" class="vc_custom_heading vc_custom_1591288701485">Send Us a Message</h2>
      <div class="wpb_text_column wpb_content_element"><div class="wpb_wrapper">
        <p>Email us at <a href="mailto:info@safeswimmingschool.com">info@safeswimmingschool.com</a> and we’ll get back to you.</p>
        <p><a class="sss-btn" href="mailto:info@safeswimmingschool.com">Email info@safeswimmingschool.com</a></p>
        <p>Prefer to text? Send a message to <a href="sms:+15612368260">561-236-8260</a>.</p>
        <p>Ready to sign up? Use our <a href="/enroll/">registration form</a>.</p>
        <p class="footer-quick-links"><strong>Quick links:</strong> {FOOTER_LINKS.map((l, i) => (<Fragment>{i > 0 && ' · '}<a href={l.href}>{l.label}</a></Fragment>))}</p>
      </div></div>
    </div></div></div><div class="wpb_column vc_column_container vc_col-sm-6"><div class="vc_column-inner"><div class="wpb_wrapper"><h2 style="text-align: left" class="vc_custom_heading vc_custom_1591288713185">Book a lesson</h2>
      <div class="wpb_text_column wpb_content_element"><div class="wpb_wrapper">
        <p><a class="sss-btn" href="/book/">Book online</a> <a href="sms:+15612368260">or text 561-236-8260</a></p>
      </div></div>
    </div></div></div></div>
    <div data-vc-full-width="true" data-vc-full-width-init="false" class="vc_row wpb_row vc_row-fluid footer-middle vc_custom_1591372672294 wpex-vc_row-has-fill wpex-vc-row-stretched"><div class="wpb_column vc_column_container vc_col-sm-12"><div class="vc_column-inner"><div class="wpb_wrapper"><h2 style="font-size: 30px;color: #ffffff;text-align: center;font-family:Chewy;font-weight:400;font-style:normal" class="vc_custom_heading">Safe Swimming School</h2><p style="font-size: 16px;color: #ffffff;text-align: center;font-family:Ubuntu;font-weight:400;font-style:normal" class="vc_custom_heading">Share Safe Swimming School with friends who need swim lessons in Palm Beach County. Text 561-236-8260.</p>
      <div class="wpb_text_column wpb_content_element"><div class="wpb_wrapper"><div class="footer-bootom-text">
        <ul>
          <li><a href="https://www.facebook.com/safeswimmingschool" target="_blank" rel="noopener"><img src="/wp-content/uploads/2020/06/si-5.png" alt="Safe Swimming School on Facebook" /></a></li>
          <li><a href="https://www.tiktok.com/@safe.swimming.sch" target="_blank" rel="noopener"><img src="/wp-content/uploads/2026/10/si-tiktok.png" alt="Safe Swimming School on TikTok" /></a></li>
        </ul>
      </div></div></div>
    </div></div></div></div><div class="vc_row-full-width vc_clearfix"></div>
    <div class="vc_row wpb_row vc_row-fluid footer-copyright-custom"><div class="wpb_column vc_column_container vc_col-sm-6"><div class="vc_column-inner"><div class="wpb_wrapper"><div class="vcex-module wpex-social-btns vcex-social-btns"></div></div></div></div><div class="wpb_column vc_column_container vc_col-sm-6"><div class="vc_column-inner"><div class="wpb_wrapper">
      <div style="text-align:right;" class="wpb_text_column wpb_content_element"><div class="wpb_wrapper"><p class="copyright-text">Safe Swimming School © {new Date().getFullYear()} All Rights Reserved <b>Terms of use</b> and <b>Privacy policy</b></p></div></div>
    </div></div></div></div>
  </div>
</footer>
