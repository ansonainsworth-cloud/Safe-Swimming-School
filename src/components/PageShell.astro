---
const { h1 } = Astro.props;
---
<header class="page-header wpex-supports-mods"><div class="page-header-inner container clr"><h1 class="page-header-title wpex-clr" itemprop="headline"><span>{h1}</span></h1></div></header>
<div id="content-wrap" class="container clr"><div id="primary" class="content-area clr"><div id="content" class="site-content clr">
<article id="single-blocks" class="single-page-article wpex-clr"><div class="single-content single-page-content entry clr">
<slot />
</div></article>
</div></div></div>
