---
import Base from '../../layouts/Base.astro';
import PortalShell from '../../components/PortalShell.astro';
import { pageChrome } from '../../data/newpage.js';
import { lessonLabel, lessons, openSlots } from '../../data/portal-mockup.js';
const path = '/portal-mockup/reschedule/';
const title = 'Request a reschedule mockup | Safe Swimming School';
const description = 'Static mockup for requesting a lesson reschedule with example times.';
---
<Base title={title} description={description} path={path} robots="noindex, nofollow" trackAnalytics={false} {...pageChrome}>
<PortalShell h1="Request a reschedule">
<div data-mock-panel>
<form class="sss-portal-form" data-mock-form method="post" action="#request">
  <fieldset>
    <legend>Pick a lesson</legend>
    {lessons.map((lesson, index) => (
      <label>
        <input type="radio" name="lesson" value={lesson.id} required={index === 0} />
        {lessonLabel(lesson)}. Lesson at your home pool
      </label>
    ))}
  </fieldset>
  <fieldset>
    <legend>based on your instructor's availability</legend>
    {openSlots.map((slot, index) => (
      <label>
        <input type="radio" name="slot" value={slot} required={index === 0} />
        {slot}
      </label>
    ))}
  </fieldset>
  <label>Note <span class="sss-optional">(optional)</span>
    <textarea name="note" rows="3" maxlength="400"></textarea>
  </label>
  <button class="sss-btn" type="submit">Send request</button>
</form>
<p class="sss-portal-confirm" data-mock-confirm hidden>Request sent. Nothing changes until we confirm it with you.</p>
</div>
</PortalShell>
</Base>
