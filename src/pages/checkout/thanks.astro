---
import Base from '../../layouts/Base.astro';
import PageShell from '../../components/PageShell.astro';
import { pageChrome } from '../../data/newpage.js';
const path = '/checkout/thanks/';
const title = 'Thank you | Safe Swimming School';
const description = 'Your Safe Swimming School checkout is complete.';
---
<Base title={title} description={description} path={path} robots="noindex, nofollow" trackAnalytics={false} {...pageChrome}>
<PageShell h1="Thank you">
<p>We received your payment.</p>
<p><a href="/">Back to the homepage</a></p>
<script is:inline>
try { localStorage.removeItem('sss-cart'); localStorage.removeItem('sss-booking'); } catch (error) {}
fetch('/api/booking-finish', { method: 'POST' }).then(function (response) {
  return response.json().then(function (data) { return { ok: response.ok, data: data }; });
}).then(function (result) {
  if (result.ok && result.data && result.data.confirmationUrl) location.replace(result.data.confirmationUrl);
}).catch(function () {});
</script>
</PageShell>
</Base>
