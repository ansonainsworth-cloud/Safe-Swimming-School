---
import Base from '../../layouts/Base.astro';
import PageShell from '../../components/PageShell.astro';
import { pageChrome } from '../../data/newpage.js';
const path = '/checkout/thanks/';
const title = 'Thank you | Safe Swimming School';
const description = 'Your Safe Swimming School checkout is complete.';
---
<Base title={title} description={description} path={path} robots="noindex, nofollow" trackAnalytics={false} {...pageChrome}>
<PageShell h1="Thank you">
<p>We received your payment. We’ll be in touch to schedule.</p>
<p><a href="/">Back to the homepage</a></p>
<script is:inline>
try { localStorage.removeItem('sss-cart'); } catch (error) {}
</script>
</PageShell>
</Base>
