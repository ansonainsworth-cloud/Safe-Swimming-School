---
import Base from '../layouts/Base.astro';
import pages from '../data/migrated-pages.json';
import { payButtonHtml, paymentLink, rewriteBookingButtons } from '../data/payment-links';
import { cartAddHtml } from '../data/cart-ui';
const bodies = import.meta.glob('../content/pages/*.html', { query: '?raw', import: 'default', eager: true });
const pricingCartIds: Record<string, string> = {
  '8 lessons': 'pkg-8',
  '12 lessons': 'pkg-12',
  '20 lessons': 'pkg-20',
  'Single lesson': 'trial',
};
const pricingPayButtons: Array<[string, string]> = [
  ['<li><strong>8 lessons:</strong> <span class="sss-pack-price">$520</span> ($65 per lesson)</li>', '8 lessons'],
  ['<li><strong>12 lessons:</strong> <span class="sss-pack-price">$720</span> ($60 per lesson)</li>', '12 lessons'],
  ['<li><strong>20 lessons:</strong> <span class="sss-pack-price">$1,100</span> ($55 per lesson)</li>', '20 lessons'],
  ['<li><strong>Annual registration fee:</strong> $35 for one swimmer, $50 for two siblings, and $60 for a family with three or more swimmers, listed separately. Annual registration (the $35, $50 or $60 fee) is waived on lock in packages bought by December 31, 2026.</li>', 'Registration'],
  ['<li><strong>Single lesson:</strong> $75 (can be credited toward a package)</li>', 'Single lesson'],
];
const winterPackageMarkup = '<li class="sss-price-secondary"><strong>Wellington winter package:</strong> 24 thirty minute lessons, January to March. Price on request. (<a href="/locations/wellington/winter-package/">details</a>)</li>';
export function getStaticPaths() {
  return pages.map((p) => ({
    params: { slug: p.path === '/' ? undefined : p.path.replace(/^\/|\/$/g, '') },
    props: { page: p },
  }));
}
const { page } = Astro.props;
let body = rewriteBookingButtons(bodies[`../content/pages/${page.slug}.html`]);
if (page.slug === 'pricing') {
  for (const [markup, label] of pricingPayButtons) {
    if (!body.includes(markup)) throw new Error(`Pricing page is missing the ${label} line`);
    const hasBook = Boolean(pricingCartIds[label]);
    const isPackage = hasBook && label !== 'Single lesson';
    const single = label === 'Single lesson';
    const payHtml = single ? payButtonHtml(paymentLink(label)) : payButtonHtml(paymentLink(label)).replace('class="sss-btn"', 'class="sss-quiet"');
    const cart = hasBook ? cartAddHtml(pricingCartIds[label]).replace('class="sss-btn"', 'class="sss-quiet"') : '';
    const book = hasBook
      ? `<a class="${isPackage || single ? 'sss-btn' : 'sss-quiet'}" href="/book/">Book online</a><a class="sss-quiet" href="sms:+15612368260">or text 561-236-8260</a>`
      : '';
    const open = hasBook
      ? `<li id="sss-${pricingCartIds[label]}" class="${isPackage ? 'sss-price-feature' : 'sss-price-secondary'}">`
      : '<li class="sss-price-secondary">';
    body = body.replace(markup, markup.replace('<li>', open).replace('</li>', `<div class="sss-pack-actions">${book}${payHtml}${cart}</div></li>`));
  }
  if (!body.includes(winterPackageMarkup)) throw new Error('Pricing page is missing the Wellington winter package line');
}
---
<Base title={page.title} description={page.description} path={page.path} bodyClass={page.bodyClass} pageStyle={page.pageStyle} ldjson={page.ldjson} robots={page.robots}>
  <Fragment set:html={body} />
</Base>
