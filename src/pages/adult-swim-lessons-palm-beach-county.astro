---
import Base from '../layouts/Base.astro';
import PageShell from '../components/PageShell.astro';
import { SITE, pageChrome, webPage, faqSchema } from '../data/newpage.js';

const path = '/adult-swim-lessons-palm-beach-county/';
const title = 'Adult Swim Lessons in Palm Beach County';
const description = 'Private adult swim lessons at your home or community pool in Palm Beach County. Beginners and nervous swimmers welcome. Text 561-236-8260.';
const palmBeach = { '@type': 'AdministrativeArea', name: 'Palm Beach County', containedInPlace: { '@type': 'State', name: 'Florida' } };
const service = {
  '@type': 'Service',
  name: 'Adult swim lessons in Palm Beach County',
  serviceType: 'Adult swim lessons',
  url: `${SITE}${path}`,
  description,
  provider: { '@id': `${SITE}/#localbusiness` },
  areaServed: palmBeach,
};
const faqs: [string, string][] = [
  ['Do you teach adult beginners and nervous swimmers?', 'Yes. We teach private, one-on-one adult lessons at your home or community pool for beginners, nervous swimmers, and adults who want to rebuild skills. Lessons move at your pace, starting with water comfort and breathing.'],
  ['Can I try one adult lesson before buying a package?', 'Yes. A single lesson is $75, and it can be credited toward a package. Packages are 8 lessons for $520, 12 for $720, or 20 for $1,100, plus annual registration of $35 for one swimmer, $50 for two, or $60 for three or more. Annual registration is waived on lock in packages bought by December 31, 2026.'],
  ['Can you keep my lessons private?', 'Yes. Lessons are one-on-one at your home or community pool, and we are happy to sign an NDA on request.'],
  ['When and where are adult lessons?', 'Your instructor comes to your home or community pool across Palm Beach County, including West Palm Beach and surrounding areas, any day from 8 AM to 7 PM.'],
];
const related = [
  ['/service/', 'how our lessons work'],
  ['/pricing/', 'Pricing'],
  ['/enroll/', 'Enroll'],
];
---
<Base title={title} description={description} path={path} {...pageChrome} ldjson={[webPage(path, 'Adult swim lessons in Palm Beach County', description, [service]), faqSchema(faqs)]}>
<PageShell h1="Adult swim lessons in Palm Beach County">
<p>Safe Swimming School teaches private adult swim lessons at your home or community pool across Palm Beach County, for beginners, nervous swimmers, and adults who want to rebuild skills. Your instructor comes to you any day from 8 AM to 7 PM, and lessons move at your pace.</p>
<p>Learning later in life is more common than many people think, and it is not too late to start. Our instructors have taught adults from their 20s through their 60s: complete beginners, people who had a hard time in the water as kids, people who want to swim laps for fitness, and people who want to feel more comfortable in the water.</p>
<h2 class="wp-block-heading">What adult lessons cover</h2>
<p>Lessons start with safety skills, then strokes. Swimmers practice how to roll to back, float and rest, and swim to the wall. These skills are one layer of protection. Nothing replaces adult supervision and pool barriers.</p>
<p>From there, the plan depends on your goal:</p>
<ul class="wp-block-list">
<li>Complete beginners: water comfort, breath control, floating, and basic propulsion</li>
<li>Nervous swimmers: a slow, patient approach, with time to build comfort step by step and the same instructor every lesson</li>
<li>Stroke technique: freestyle, backstroke, and breaststroke</li>
<li>Lap swimming for fitness: efficiency, breathing rhythm, and endurance</li>
</ul>
<p>Each lesson is private and 30 minutes. Siblings can share a semi-private lesson.</p>
<h2 class="wp-block-heading">Private lessons at your own pool</h2>
<p>In a private lesson, it is just you and your instructor. You set the pace. Practice happens in the water you already know, at your home or community pool, so you do not have to drive to a swim school.</p>
<p>We teach across Palm Beach County, including West Palm Beach and surrounding areas. Wellington and Royal Palm Beach are examples, not a limit. If your town is not listed, ask. See <a href="/locations/">all locations</a>.</p>
<p>Lessons are taught by certified instructors, led by founder Cortney Berry, with 20 years of experience, and cofounder Anson Ainsworth, with 18 years of experience. Safe Swimming School is fully insured. If you want privacy, we are happy to sign an NDA.</p>
<h2 class="wp-block-heading">Pricing</h2>
<p>A single lesson is $75 and can be credited toward a package. Packages are 8 lessons for $520, 12 for $720, or 20 for $1,100, plus annual registration of $35 for one swimmer, $50 for two siblings, and $60 for a family with three or more swimmers. Annual registration is waived on lock in packages bought by December 31, 2026, and those lessons never expire. Refer a friend: when a friend you refer buys any package by December 31, 2026, you get 1 free lesson.</p>
<p>Text <a href="sms:+15612368260">561-236-8260</a> with your goal, your pool type, and your preferred days, and we will plan the first lesson around you.</p>
<h2 class="wp-block-heading">FAQs</h2>
{faqs.map(([q, a]) => (
  <Fragment>
    <p><strong>{q}</strong></p>
    <p>{a}</p>
  </Fragment>
))}
<h2 class="wp-block-heading">Related</h2>
<ul class="wp-block-list">
{related.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
</ul>
</PageShell>
</Base>
