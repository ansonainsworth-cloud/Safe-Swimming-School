---
import Base from '../../layouts/Base.astro';
import PageShell from '../../components/PageShell.astro';
import { pageChrome, webPage } from '../../data/newpage.js';

const path = '/parent-playbooks/thank-you/';
const title = 'Your playbooks are on the way | Safe Swimming School';
const description = 'Your parent playbook library is on the way by email. Check spam if you do not see it soon.';
const h1 = 'Your playbooks are on the way';
---
<Base title={title} description={description} path={path} robots="noindex, nofollow" {...pageChrome} ldjson={[webPage(path, h1, description)]}>
<PageShell h1={h1}>
<p>Your playbooks are on the way to your inbox. Start with Playbook 1, then watch Trust Before Technique when you have ten minutes. If you are in Palm Beach County and you want to talk through whether lessons fit your child, text me at <a href="sms:+15612368260">561 236 8260</a>.</p>
<p>Check your spam folder if you do not see it soon.</p>
</PageShell>
</Base>
