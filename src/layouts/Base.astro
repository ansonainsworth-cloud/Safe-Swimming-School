---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { GA_ID, SITE } from '../data/site.js';
import { bookingHref } from '../data/payment-links';
import { clientCatalog, REGISTRATION_TIER_CENTS } from '../../functions/_lib/prices';
const { title, description, path, bodyClass = 'page wpex-theme wpex-responsive full-width-main-layout no-composer content-full-width sidebar-widget-icons hasnt-overlay-header smooth-fonts wpex-mobile-toggle-menu-icon_buttons has-mobile-menu wpex-disable-mm-focus-styles wpb-js-composer js-comp-ver-6.1 vc_responsive', pageStyle = '', ldjson = [], robots = 'index, follow, max-image-preview:large', ogImage = '/images/brand/safe-swimming-school-logo-800.png', ogType = 'website', trackAnalytics = true, checkoutAnalytics = false } = Astro.props;
const loadGtag = trackAnalytics || checkoutAnalytics;
const checkoutOnly = checkoutAnalytics && !trackAnalytics;
const catalog = clientCatalog();
const canonical = SITE + path;
const wpexLocalize = `var wpexLocalize = {"isRTL":"","mainLayout":"full-width","menuSearchStyle":"drop_down","siteHeaderStyle":"one","megaMenuJS":"1","superfishDelay":"600","superfishSpeed":"fast","superfishSpeedOut":"fast","menuWidgetAccordion":"1","hasMobileMenu":"1","mobileMenuBreakpoint":"959","mobileMenuStyle":"toggle","mobileMenuToggleStyle":"icon_buttons","scrollToHash":"1","scrollToHashTimeout":"500","localScrollUpdateHash":"","localScrollHighlight":"1","localScrollSpeed":"1000","localScrollEasing":"easeInOutExpo","scrollTopSpeed":"1000","scrollTopOffset":"100","responsiveDataBreakpoints":{"tl":"1024px","tp":"959px","pl":"767px","pp":"479px"},"ajaxurl":"","loadMore":{"text":"Load More","loadingText":"Loading&hellip;","failedText":"Failed to load posts."},"i18n":{"openSubmenu":"Open submenu of %s","closeSubmenu":"Close submenu of %s"},"hasStickyHeader":"1","stickyheaderCustomLogo":"/images/brand/safe-swimming-school-logo-800.png","stickyHeaderStyle":"standard","hasStickyMobileHeader":"","overlayHeaderStickyTop":"0","stickyHeaderBreakPoint":"960","animateMobileToggle":"1","mobileToggleMenuPosition":"afterheader","customSelects":""};`;
---
<!doctype html>
<html lang="en-US">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
<meta name="robots" content={robots} />
<link rel="canonical" href={canonical} />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="Safe Swimming School" />
<meta property="og:image" content={new URL(ogImage, SITE).href} />
<meta name="twitter:card" content="summary_large_image" />
<link rel="icon" href="/favicon.ico" />
<link rel="icon" href="/wp-content/uploads/2026/05/favicon-512-150x150.png" sizes="32x32" />
<link rel="icon" href="/wp-content/uploads/2026/05/favicon-512-300x300.png" sizes="192x192" />
<link rel="apple-touch-icon" href="/wp-content/uploads/2026/05/favicon-512-300x300.png" />
{loadGtag && <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>}
{loadGtag && <script is:inline define:vars={{ GA_ID, checkoutOnly }}>window.dataLayer=window.dataLayer||[];window.gtag=function(){window.dataLayer.push(arguments);};window.gtag('js',new Date());if(checkoutOnly){window.gtag('config',GA_ID,{send_page_view:false});}else{window.gtag('config',GA_ID);}</script>}
<link rel="stylesheet" href="/wp-content/plugins/js_composer/assets/css/js_composer.min.css" />
<link rel="stylesheet" href="/wp-includes/css/dist/block-library/style.min.css" />
<link rel="stylesheet" href="/wp-content/themes/Total/style.css" />
<link rel="stylesheet" href="/wp-content/themes/Total/assets/css/wpex-visual-composer.css" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Ubuntu:300,300i,400,400i,500,500i,700,700i&display=swap" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Chewy:regular&display=swap" />
<link rel="stylesheet" href="/css/wp-inline.css" />
<link rel="stylesheet" href="/css/tokens.css" />
<link rel="stylesheet" href="/css/site.css" />
{pageStyle && <style is:inline set:html={pageStyle}></style>}
<style is:inline>
body{font-size:var(--sss-font-body);line-height:1.7;color:var(--sss-ink)}
.container{width:min(var(--sss-measure),calc(100% - 48px)) !important;max-width:var(--sss-measure) !important}
@media (max-width:768px){
.container,#site-header-inner,.page-header-inner,.custom-topbar .textwidget>div{width:100% !important;max-width:100% !important;margin-left:0 !important;margin-right:0 !important;padding-left:20px !important;padding-right:20px !important;box-sizing:border-box !important}
}
.single-content p,.entry p{font-size:var(--sss-font-body);line-height:1.7;color:var(--sss-ink);margin:0 0 var(--sss-space-2)}
.single-content h2,.entry h2{color:var(--sss-blue-deep);font-size:var(--sss-font-h2);line-height:1.25;margin:var(--sss-space-4) 0 12px}
.single-content h1,.entry h1{color:var(--sss-blue-deep);font-size:var(--sss-font-h1);line-height:1.15;margin:0 0 var(--sss-space-2)}
#site-header-inner{padding-top:6px !important;padding-bottom:6px !important;height:auto !important}
#site-logo,#site-logo-inner,#site-logo a{width:auto !important;height:auto !important;max-width:none !important;overflow:visible !important}
#site-logo img{height:84px !important;width:auto !important;max-width:none !important;max-height:none !important}
.page-header.wpex-supports-mods{background-color:var(--sss-blue-deep) !important;border-color:var(--sss-blue-deep) !important;padding:14px 0 !important;margin:0 0 8px !important}
.page-header .page-header-title{color:#fff !important;font-size:var(--sss-font-h2) !important;line-height:1.2 !important}
.vc_custom_1591372672294,.footer-middle{background-color:var(--sss-blue-deep) !important;background-image:none !important}
a{color:var(--sss-blue)}
.single-content a:not(.sss-btn),.entry a:not(.sss-btn){text-decoration:underline;text-underline-offset:2px}
.sss-btn,button.sss-btn{background-color:var(--sss-blue) !important;color:#fff !important}
.sss-btn:hover,button.sss-btn:hover{background-color:var(--sss-blue-deep) !important;opacity:1}
#site-navigation .dropdown-menu a,#site-navigation .dropdown-menu > li > a,#site-navigation .dropdown-menu > li > a .link-inner{color:var(--sss-blue-deep) !important;font-size:18px !important}
.sss-hero-banner h1{font-size:52px !important;line-height:1.08 !important;color:#fff !important}
.sss-hero-banner p{font-size:18px !important;line-height:1.6 !important;color:#fff !important}
.sss-hero-banner img{position:absolute !important;inset:0 !important;width:100% !important;max-width:none !important;height:100% !important;object-fit:cover !important;object-position:center 30% !important}
.single-content figure img{width:100% !important;max-width:100% !important;height:180px !important;object-fit:cover !important}
@media (max-width:767px){
#site-logo img{height:64px !important}
.sss-hero-banner{min-height:460px !important}
.sss-hero-banner h1{font-size:34px !important}
.single-content figure img{height:140px !important}
}
.sss-holiday-banner a,.sss-mobile-bar a,.footer-middle a,.sss-section-close a{color:#fff !important}
.sss-mobile-bar .sss-mobile-bar-cta{background-color:var(--sss-blue) !important;color:#fff !important}
.sss-section-close .sss-btn{background-color:var(--sss-blue) !important;color:#fff !important}
p.copyright-text b{color:#fff}
</style>
{ldjson.map((j) => <script type="application/ld+json" is:inline set:html={j}></script>)}
</head>
<body class={bodyClass}>
<div class="sss-holiday-banner" role="region" aria-label="Holiday gift certificates">
<p>Give the gift of swim lessons this holiday. <a href="/gift-certificates/">Shop gift certificates</a></p>
</div>
<div class="custom-topbar" role="region" aria-label="Cart and phone"><div id="text-5" class="sidebar-box widget widget_text clr"><div class="textwidget"><div style="padding:10px 0; line-height:1.4; text-align:right;"><a href="/cart/" id="sss-cart-link">Cart (<span id="sss-cart-count">0</span>)</a><a href="sms:+15612368260" style="display:block; font-weight:700; font-size:15px; color:#033761; text-decoration:none; margin-bottom:4px;">Text 561-236-8260</a><span style="display:block; font-size:11px; color:#033761; opacity:0.8; letter-spacing:0.5px; text-transform:uppercase;">Palm Beach County</span></div></div></div></div>
<div class="wpex-site-overlay"></div>
<nav class="sss-skip" aria-label="Skip"><a href="#content" class="skip-to-content">skip to Main Content</a></nav>
<div id="outer-wrap" class="clr"><div id="wrap" class="clr">
<Header path={path} />
<main id="main" class="site-main clr"><slot /></main>
<Footer />
</div></div>
<nav class="sss-mobile-bar" aria-label="Quick contact"><a href="sms:+15612368260">Text us</a><a href="mailto:info@safeswimmingschool.com">Email</a><a href={bookingHref()} class="sss-mobile-bar-cta">Enroll</a></nav>
<a href="#outer-wrap" id="site-scroll-top"><span class="ticon ticon-chevron-up" aria-hidden="true"></span><span class="screen-reader-text">Back To Top</span></a>
<script is:inline src="/wp-includes/js/jquery/jquery.min.js"></script>
<script is:inline src="/wp-includes/js/jquery/jquery-migrate.min.js"></script>
<script is:inline set:html={wpexLocalize}></script>
<script is:inline src="/wp-content/themes/Total/assets/js/total.min.js"></script>
<script is:inline define:vars={{ SSS_CATALOG: catalog, SSS_REGISTRATION_TIERS: REGISTRATION_TIER_CENTS }}>window.SSS_CATALOG = SSS_CATALOG; window.SSS_REGISTRATION_TIERS = SSS_REGISTRATION_TIERS;</script>
<script is:inline src="/js/cart.js"></script>
{trackAnalytics && <script is:inline type="module" src="/js/ga-events.js"></script>}
</body>
</html>
