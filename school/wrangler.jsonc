{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "safe-swimming-school-app",
  "account_id": "14ab4bda10102f5322383b8cf612b1b9",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // Pages project safe-swimming-school-app publishes ./public at
  // app.safeswimmingschool.com. This Worker serves those files locally and
  // handles /api on that hostname. Do not attach it to the marketing site.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_NAME": "Safe Swimming School",
    "DATA_SOURCE": "mock",
    "CALENDAR_NAME": "Anson Ainsworth Swim",
    "CALENDAR_ID": "",
    "LESSON_TRACKER_SPREADSHEET_ID": "",
    "LESSON_TRACKER_RANGE": "Lesson Tracker!A2:F",
    "GOOGLE_SERVICE_ACCOUNT_EMAIL": "",
    "SMS_PROVIDER": "stub",
    "SMS_FROM_NUMBER": "",
    "EMAIL_PROVIDER": "stub",
    "CLOCK_IN_RADIUS_YARDS": "100",
    "LATE_THRESHOLD_MINUTES": "5",
    "AUTO_DECREMENT_ON_CLOCK_OUT": "true",
    "ARRIVAL_TEXT_ENABLED": "true",
    "ARRIVAL_TEXT_MINUTES": "10",
    "EXPOSE_DEV_MAGIC_LINK": "true",
    "ALLOW_PREVIEW_LOCATION": "true",
    "TIMEZONE": "America/New_York"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "safe-swimming-school-app",
      "database_id": "fba323f1-138a-4f5f-b12a-28ecc984c368",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "app.safeswimmingschool.com/api/*",
      "zone_name": "safeswimmingschool.com"
    }
  ],
  "triggers": {
    "crons": ["15 * * * *"]
  }
}
