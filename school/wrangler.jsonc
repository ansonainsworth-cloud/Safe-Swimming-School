{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "safe-swimming-school-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  // Pages publishes ./public. This Worker serves the same files locally
  // and handles /api. Do not deploy from this repo until credentials exist.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "APP_NAME": "Safe Swimming School",
    "DATA_SOURCE": "mock",
    "CALENDAR_NAME": "Anson Ainsworth Swim",
    "CALENDAR_ID": "",
    "LESSON_TRACKER_SPREADSHEET_ID": "",
    "LESSON_TRACKER_RANGE": "Lesson Tracker!A2:F",
    "GOOGLE_SERVICE_ACCOUNT_EMAIL": "",
    "SMS_PROVIDER": "stub",
    "SMS_FROM_NUMBER": "",
    "EMAIL_PROVIDER": "stub",
    "CLOCK_IN_RADIUS_YARDS": "100",
    "LATE_THRESHOLD_MINUTES": "5",
    "AUTO_DECREMENT_ON_CLOCK_OUT": "true",
    "ARRIVAL_TEXT_ENABLED": "true",
    "ARRIVAL_TEXT_MINUTES": "10",
    "EXPOSE_DEV_MAGIC_LINK": "true",
    "ALLOW_PREVIEW_LOCATION": "true",
    "TIMEZONE": "America/New_York"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "safe-swimming-school-app",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["15 * * * *"]
  }
}
